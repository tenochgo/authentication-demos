{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "AzureAd": {
    "Instance": "https://login.microsoftonline.com/",
    "TenantId": "<tenant-id>",
    "ClientId": "<client-id>",
    "ClientSecret": "<client-secret>",
    "CallbackPath": "/signin-oidc",
    "SignedOutCallbackPath": "/signout-callback-oidc",
    "RedirectBaseUrl": "http://localhost:5001"
  },
  "DownstreamApis": {
    "Storage": {
      "Scopes": ["https://storage.azure.com/user_impersonation"]
    },
    "Sql": {
      "Scopes": ["https://database.windows.net/user_impersonation"]
    }
  },
  "AzureResources": {
    "StorageAccountName": "<storage-account-name>",
    "SqlServer": "<server>.database.windows.net",
    "SqlDatabase": "<database-name>"
  },
  "Foundry": {
    "Endpoint": "https://<your-resource>.services.ai.azure.com/openai/v1/",
    "ModelDeployment": "<your-model-deployment-name>",
    "SystemPrompt": "You are a helpful assistant. Be concise and clear.",
    "MaxTokens": 1000,
    "Temperature": 0.7
  }
}
